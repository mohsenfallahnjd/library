DATABASE_URL=postgres://library:library@localhost:5434/library
# Password for the login page. Also used to sign the session cookie unless AUTH_SECRET is set.
LIBRARY_PASSWORD=
# Optional: separate secret for signing the session cookie (rotating it signs everyone out).
AUTH_SECRET=
# Token for POST /api/items (iOS Shortcut). Send as "Authorization: Bearer <token>".
LIBRARY_API_TOKEN=
# Optional: Vercel Blob. When empty, PDFs are stored on disk in ./uploads.
BLOB_READ_WRITE_TOKEN=
